# ─── LangChain Sandbox 标准测试所需环境变量 ───
# 复制本文件为 .env.test（项目根目录，与 tests/ 同级）并填入真实值。
# test_sandbox.py 通过 load_dotenv(".env.test") 加载，且 CUBE_TEMPLATE_ID 为必填。

# 必填：Cube 沙箱模板 ID（启动 MicroVM 用的镜像/模板）
CUBE_TEMPLATE_ID=your_template_id_here

# 可选：Cube 沙箱服务地址（E2B 兼容 API）。默认见下。
CUBE_API_URL=http://192.168.10.136:13000

# 可选：API Key。本地开发可用 dummy。
CUBE_API_KEY=dummy

# 可选：CA 证书路径（PEM）。用于 SSL 校验；
# 若留空/不设置，CubeSandbox 会跳过证书校验（开发环境）。
# Windows 路径用正斜杠或双反斜杠，例如：
# CUBE_SSL_CERT=D:/workspace/langchain-cubesandbox/cube-ca.pem
CUBE_SSL_CERT=
